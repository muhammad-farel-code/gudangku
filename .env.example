APP_NAME=GudangKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Konfigurasi Database Utama (MySQL Wajib)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gudangku
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi Session (Database Driver untuk Audit & Keamanan)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Konfigurasi Cache & Queue
CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# ==============================================================================
# PANDUAN LINGKUNGAN PRODUCTION (Clever Cloud / Cloud PaaS)
# ==============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<app-id>.cleverapps.io
# LOG_CHANNEL=syslog
# LOG_LEVEL=info
# SESSION_SECURE_COOKIE=true
#
# Pada Clever Cloud, kredensial MySQL disuntikkan otomatis via Add-on:
# MYSQL_ADDON_HOST, MYSQL_ADDON_PORT, MYSQL_ADDON_DB, MYSQL_ADDON_USER, MYSQL_ADDON_PASSWORD
# Otomatis dibaca sebagai fallback di config/database.php.
#
# Reverse Proxy Clever Cloud (diinjeksikan otomatis oleh platform):
# CC_REVERSE_PROXY_IPS=10.0.0.1,10.0.0.2
#
# Hook Eksekusi Migrasi Saat Build di Clever Cloud:
# CC_POST_BUILD_HOOK="php artisan migrate --force"
